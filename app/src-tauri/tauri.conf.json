{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PerfectUninstaller",
  "version": "0.1.0",
  "identifier": "com.enkivus.perfectuninstaller",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PerfectUninstaller",
        "width": 1280,
        "height": 840,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Complete software removal",
    "longDescription": "PerfectUninstaller removes an application together with every residual trace it leaves behind, with a full audit log and an exportable report."
  }
}
